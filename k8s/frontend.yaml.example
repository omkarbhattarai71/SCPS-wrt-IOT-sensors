apiVersion: v1
kind: ConfigMap
metadata:
  name: frontend-config
  namespace: smart-parking
data:
  API_URL: "http://localhost:8000"
  REACT_APP_FIREBASE_API_KEY: "CHANGE_ME_your_firebase_api_key"
  REACT_APP_FIREBASE_AUTH_DOMAIN: "your-project-id.firebaseapp.com"
  REACT_APP_FIREBASE_PROJECT_ID: "your-project-id"
  REACT_APP_FIREBASE_STORAGE_BUCKET: "your-project-id.firebasestorage.app"
  REACT_APP_FIREBASE_MESSAGING_SENDER_ID: "your_sender_id"
  REACT_APP_FIREBASE_APP_ID: "your_app_id"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  namespace: smart-parking
spec:
  replicas: 2
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      containers:
      - name: frontend
        image: smart-parking-frontend:latest
        imagePullPolicy: Never
        ports:
        - containerPort: 3000
          name: http
        envFrom:
        - configMapRef:
            name: frontend-config
        livenessProbe:
          httpGet:
            path: /
            port: 3000
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /
            port: 3000
          initialDelaySeconds: 10
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
        resources:
          requests:
            memory: "256Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "500m"
---
apiVersion: v1
kind: Service
metadata:
  name: frontend
  namespace: smart-parking
spec:
  selector:
    app: frontend
  ports:
  - port: 80
    targetPort: 3000
    name: http
  type: LoadBalancer
