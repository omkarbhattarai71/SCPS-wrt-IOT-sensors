# React App Configuration
REACT_APP_API_URL=http://CHANGE_ME:8000

# Firebase Configuration
# Get these from your Firebase project console or from the root .env file
REACT_APP_FIREBASE_API_KEY=CHANGE_ME
REACT_APP_FIREBASE_AUTH_DOMAIN=CHANGE_ME.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=CHANGE_ME
REACT_APP_FIREBASE_STORAGE_BUCKET=CHANGE_ME.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
REACT_APP_FIREBASE_APP_ID=CHANGE_ME
REACT_APP_FIREBASE_MEASUREMENT_ID=CHANGE_ME
